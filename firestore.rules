rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visualizers/{visualizerId} {
      // Anyone can browse community visualizers
      allow read: if true;
      // Allow creating a new visualizer with valid payload
      allow create: if request.resource.data.name is string
                    && request.resource.data.code is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.code.size() > 0
                    && request.resource.data.code.size() <= 50000;
      // Allow upvoting/liking and incrementing download/import counter
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'importsCount', 'likedIps']);
      allow delete: if false;
    }
  }
}
